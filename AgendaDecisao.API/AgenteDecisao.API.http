@AgenteDecisao.API_HostAddress = http://localhost:5240
@AgenteDecisaoApiKey = defina-sua-chave
@AgenteClienteId = cliente-demo

GET {{AgenteDecisao.API_HostAddress}}/health
Accept: application/json

###

GET {{AgenteDecisao.API_HostAddress}}/metrics
Accept: text/plain

###

POST {{AgenteDecisao.API_HostAddress}}/api/agente
Content-Type: application/json
X-Agente-Api-Key: {{AgenteDecisaoApiKey}}
X-Agente-Client-Id: {{AgenteClienteId}}

{
  "entradaUsuario": "Cliente sinalizou dificuldade pontual de pagamento",
  "cliente": {
    "nome": "Cliente Exemplo",
    "diasInadimplente": 75
  },
  "assinatura": {
    "status": "ATIVA"
  }
}

###
